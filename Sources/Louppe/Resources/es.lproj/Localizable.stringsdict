		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count1@</string>
		<key>count1</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Louppe no pudo terminar de comprobar %2$@ archivo interrumpido. </string>
			<key>other</key>
			<string>Louppe no pudo terminar de comprobar %2$@ archivos interrumpidos. </string>
		</dict>
	</dict>
