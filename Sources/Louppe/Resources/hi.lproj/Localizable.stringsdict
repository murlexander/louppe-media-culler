		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count1@</string>
		<key>count1</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Louppe अधूरी कार्रवाई की %2$@ फ़ाइल की जाँच पूरी नहीं कर सका। </string>
