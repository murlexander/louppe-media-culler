			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$@ arquivo (cerca de %3$@) será movido para a Lixeira. O arquivo %4$@ correspondente ficará na pasta.</string>
			<key>other</key>
