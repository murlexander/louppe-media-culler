	<key>%lld files (about %@) will be moved to the Trash. The matching %@ files will stay in the folder.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@count1@</string>
		<key>count1</key>
		<dict>
